# Dependencies & build output
node_modules/
.pnpm-store/
dist/
server-dist/
coverage/
*.tsbuildinfo
vite.config.*.timestamp-*
.vite/
.cache/

# Local configuration & secrets: never commit
.env
.env.*
!.env.example
.claude/settings.local.json

# Local data: embedded dev database, backups, dumps and archives (may contain personal data)
.data/
backups/
*.dump
*.gz
*.zip

# Spreadsheets and exports: the RCCG parish list and its issue reports, applicant CSV
# exports (personal data). The repository is public; tests build their own sample files.
*.xlsx
*.xls
*.csv

# Large design originals (a compressed copy is committed)
design/*-figma.png
# AI-generated image originals (the site builds from design/imagery/*/masters: docs/IMAGERY.md)
design/imagery/*/originals/

# Logs & OS files
logs/
*.log
.DS_Store
