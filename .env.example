# ─────────────────────────────────────────────────────────────────────────────
# School of Purpose: configuration reference.
# Copy to .env and fill in. Never commit .env (it is git-ignored).
# The server reads .env on startup; real environment variables take precedence.
# ─────────────────────────────────────────────────────────────────────────────

# ── Used by docker-compose.yml (VPS deployment) ─────────────────────────────
# Public domain for the site. Point its DNS A/AAAA record at the VPS first;
# Caddy then obtains and renews the HTTPS certificate automatically.
DOMAIN=apply.example.org
# on: www.DOMAIN redirects to https://DOMAIN (its DNS must point at the VPS too). Left unset,
# deploy/install.sh switches it on when it finds that record; otherwise it stays off.
# WWW_REDIRECT=on
# Postgres credentials for the bundled database container.
# Generate the password with:  openssl rand -hex 24   (left empty, Compose refuses to start)
POSTGRES_DB=sop
POSTGRES_USER=sop
POSTGRES_PASSWORD=

# ── App server ──────────────────────────────────────────────────────────────
# Port the Node server listens on (behind Caddy/Nginx). Default 3000.
PORT=3000
# Interface to bind. 127.0.0.1 (default) when a reverse proxy runs on the same
# host; docker-compose sets 0.0.0.0 inside the container.
# HOST=127.0.0.1

# Database. Either a URL…
#   DATABASE_URL=postgres://sop:PASSWORD@127.0.0.1:5432/sop
# …or the standard PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE variables (no
# URL-encoding needed). With neither set, development uses an embedded
# database in .data/pglite; production refuses to start.
# DATABASE_SSL=false      # true for managed databases that require TLS
# DB_POOL_MAX=10

# Which reverse proxies may set X-Forwarded-For. Needed so rate limits apply
# per visitor, not per proxy. Bare metal behind Nginx: loopback.
# Docker (set in docker-compose.yml): loopback,uniquelocal
# TRUST_PROXY=loopback

# ── Required in production ──────────────────────────────────────────────────
# The site's public address (origin only, https). Used for links in emails, the
# admin area's origin checks and secure cookies. docker-compose derives it from DOMAIN
# unless it is set here (the website on Vercel: its https://….vercel.app or own domain).
# SITE_URL=https://apply.example.org
# Secret for signing CSRF tokens and encrypting stored push subscriptions and
# two-step-verification secrets. At least 32 characters. Generate once with:
#   openssl rand -base64 48
# Changing it signs everyone out, and push subscriptions and staff authenticator
# set-ups must then be redone (docs/DEPLOYMENT.md "Rotating secrets").
APP_SECRET=

# ── Website on Vercel (optional; docs/DEPLOYMENT.md "C. Website on Vercel") ──
# When Vercel serves the website and forwards /api to this server, set SITE_URL
# (above) to the Vercel address and give the Vercel project the same secret. Vercel
# then passes on each visitor's address, so rate limits stay per visitor. At least
# 32 characters, different from APP_SECRET:  openssl rand -base64 48
# EDGE_PROXY_SECRET=

# ── Email (optional; applicant sign-in and emailed staff invitations need it) ─
# Any SMTP provider (e.g. Postmark, Mailgun, Amazon SES, Zoho). smtps:// uses TLS from the
# start; smtp:// (port 587) must upgrade with STARTTLS, or nothing is sent (a relay on this
# server is exempt).
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# EMAIL_FROM="School of Purpose <no-reply@apply.example.org>"
# Without SMTP_URL, email is off in production (sign-in by email is switched off,
# never faked). In development the default is a local test outbox, viewable at
# http://localhost:3000/api/dev/outbox. EMAIL_TRANSPORT=smtp|none|outbox overrides.
# EMAIL_TRANSPORT=

# ── Web Push notifications (optional) ────────────────────────────────────────
# Generate a key pair ONCE and keep the private key only here (and in your backups):
#   pnpm push:keys            (or: node server-dist/push-keys.js)
# Changing the keys means every device must turn notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact push services can reach about your sending: mailto: or https:.
# VAPID_SUBJECT=mailto:programme-team@example.org
# Extra push service hosts to allow (the major browsers' services are built in).
# PUSH_ENDPOINT_HOSTS=

# ── Background worker ────────────────────────────────────────────────────────
# inline (default): jobs run inside the web server. off: run `node server-dist/worker.js`
# separately (docker-compose does this).
# WORKER_MODE=inline
# WORKER_POLL_MS=2000

# ── Sign-in and sessions ─────────────────────────────────────────────────────
# Two-step verification for staff: always on in production unless set to false.
# STAFF_MFA_REQUIRED=true
# STAFF_SESSION_HOURS=12
# STAFF_IDLE_MINUTES=120
# APPLICANT_SESSION_DAYS=30
# APPLICANT_IDLE_DAYS=14
# Secure cookies: automatic (on for an https SITE_URL).
# COOKIE_SECURE=

# Submissions allowed per visitor address. Keep generous: a church hall on one
# Wi-Fi network (or a mobile carrier's shared IP) looks like one visitor.
# RATE_LIMIT_SUBMIT_MAX=20
# RATE_LIMIT_SUBMIT_WINDOW_MINUTES=10

# Apply database migrations automatically at startup (default true).
# RUN_MIGRATIONS=true
# LOG_LEVEL=info

# ── Build-time (baked into the website when it is built) ────────────────────
# SITE_URL (above) also makes social-media previews absolute (og:url / og:image).
# Public contact email for the Programme team. "Contact" links stay hidden
# until this is set.
# VITE_CONTACT_EMAIL=
# Release id for the service worker and update checks (e.g. the git commit).
# A timestamp when empty.
# BUILD_ID=
# Emergency only: 1 builds a service worker that deletes its caches and
# unregisters itself (docs/DEPLOYMENT.md "Service worker rollback").
# SW_KILL_SWITCH=

# ── Development only ────────────────────────────────────────────────────────
# Port for the API during `pnpm dev` (Vite proxies /api to it). Default 3000.
# API_PORT=3000
# PGLITE_DATA_DIR=.data/pglite
