{
  "name": "school-of-purpose",
  "private": true,
  "version": "1.0.0",
  "description": "School of Purpose \u00b7 Purpose Boot Camp expression-of-interest site (RCCG Young Adults & Youth)",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors magenta,cyan \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false server/dev.ts",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server-dist/index.js",
    "db:migrate": "node server-dist/migrate.js",
    "db:migrate:dev": "tsx server/migrate-cli.ts",
    "admin": "node --import tsx server/admin-cli.ts",
    "push:keys": "node --import tsx server/vapid-cli.ts",
    "worker": "node server-dist/worker.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "format": "oxfmt"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.1"
  }
}
