# What a CLI deploy (vercel deploy) must never upload from a working copy: local secrets and
# data, dumps and archives, build output and dependencies. Git deploys only see committed files.
.env
.env.*
.data/
backups/
*.dump
*.gz
*.zip
*.sql
!server/migrations/*.sql
*.bak
*.tar
*.tgz
*.7z
*.pem
*.key
*.p12
*.pfx
.envrc
# Spreadsheets and exports (the RCCG list, applicant CSVs), logs and OS files
*.xlsx
*.xls
*.csv
*.tsv
*.ods
*.numbers
*.log
**/.DS_Store
dist/
server-dist/
node_modules/
.pnpm-store/
design/*-figma.png
.claude/
SECURITY-AUDIT.md
